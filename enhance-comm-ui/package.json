{
  "name": "enhance-comm-ui",
  "version": "0.19.3",
  "private": true,
  "description": "Adventure.land /hub UI enhancement userscript (formerly /comm)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/clean-dist.mjs && tsup && node scripts/sync-root.mjs",
    "test": "tsx --test tests/**/*.test.ts",
    "watch": "node scripts/dev-watch.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:serve": "node scripts/dev-server.mjs",
    "overlay:sync": "node scripts/fetch-overlay-client.mjs",
    "overlay:shot": "node agentic/overlay-shot/capture.mjs",
    "phone:flows": "node agentic/mobile-preview/flows/drive-real-flows.mjs",
    "prototype:farm": "node agentic/farm-tracker-prototype/open.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "tsup": "^8.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "uqr": "^0.1.3"
  }
}
